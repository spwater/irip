# IRIP 平台环境变量样例 —— 复制为 .env 后按需修改（.env 不入库）
# 所有敏感值仅作本地开发占位，生产环境必须替换。

# ---- 应用基础 ----
IRIP_ENV=development
IRIP_LOG_LEVEL=INFO

# ---- PostgreSQL 16（权威存储）----
# 本机开发用 5432，Docker Compose 用容器名 postgres:5432
IRIP_DATABASE_URL=postgresql+psycopg://irip:irip_dev_password@localhost:5432/irip
# Docker Compose 中数据库的用户/密码/库名
IRIP_DATABASE_USER=irip
IRIP_DATABASE_PASSWORD=irip_dev_password
IRIP_DATABASE_NAME=irip

# ---- Redis（Celery broker，非权威存储）----
IRIP_REDIS_URL=redis://localhost:6379/0
IRIP_CELERY_BROKER_URL=redis://localhost:6379/0
IRIP_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- MinIO（S3 兼容对象存储，内容寻址）----
# 本机开发端口 9000，Docker Compose 中用 http://minio:9000
IRIP_MINIO_ENDPOINT=http://localhost:9000
IRIP_MINIO_ACCESS_KEY=irip
IRIP_MINIO_SECRET_KEY=irip_dev_password
IRIP_MINIO_BUCKET=irip-artifacts
IRIP_MINIO_REGION=us-east-1

# ---- 认证 / 会话 ----
# 仅用于本地开发的 JWT 签名密钥，生产必须使用随机 64 字节以上密钥
IRIP_JWT_SECRET=dev_only_insecure_jwt_secret_change_me_0123456789abcdef
IRIP_JWT_ALGORITHM=HS256
IRIP_ACCESS_TOKEN_TTL_SECONDS=900
IRIP_REFRESH_TOKEN_TTL_SECONDS=604800

# ---- API 服务 ----
IRIP_API_HOST=0.0.0.0
IRIP_API_PORT=8000
IRIP_API_CORS_ORIGINS=http://localhost:5173,http://localhost

# ---- 引导管理员（bootstrap 幂等创建）----
IRIP_BOOTSTRAP_ADMIN_EMAIL=admin@irip.local
IRIP_BOOTSTRAP_ADMIN_PASSWORD=Admin-IRIP-2026
IRIP_BOOTSTRAP_ORG_NAME="IRIP 演示组织"

# ---- 系统服务用户（bootstrap 幂等创建，供 Celery worker 使用）----
# 由 bootstrap 脚本输出，worker 用此 ID 作为 actor_id / created_by / uploaded_by
IRIP_SYSTEM_SERVICE_USER_ID=

# ---- 测试环境（test.compose.yaml 端口）----
# 导出这些变量后运行集成测试：
#   export IRIP_TEST_DATABASE_URL=postgresql+psycopg://irip:irip_dev_password@localhost:55432/irip_test
#   export IRIP_DATABASE_URL=postgresql+psycopg://irip:irip_dev_password@localhost:55432/irip_test
#   export IRIP_REDIS_URL=redis://localhost:56379/0
#   export IRIP_MINIO_ENDPOINT=localhost:59000
#   export IRIP_MINIO_ACCESS_KEY=irip
#   export IRIP_MINIO_SECRET_KEY=irip_dev_password
#   export IRIP_MINIO_BUCKET=irip-test
#   export IRIP_JWT_SECRET=test-secret
#   export IRIP_BOOTSTRAP_ADMIN_PASSWORD=Admin-IRIP-2026
#   docker compose -f deployments/compose/test.compose.yaml up -d
#   .venv/bin/python -m alembic upgrade head
#   .venv/bin/python -m pytest tests/integration -v
