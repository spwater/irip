{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irip/schemas/mapping-profile/v1.schema.json",
  "title": "MappingProfile v1",
  "description": "IRIP 数据导入映射配置文档 v1。定义外部数据源（文件/PostgreSQL/REST）到平台已发布标准变量的字段映射规则。安全约定：敏感凭据（DSN/token）仅以 secret_id 引用，绝不内联明文。",
  "type": "object",
  "required": ["name", "source", "rules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "映射配置名称（组织内唯一）。"
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["file", "postgres", "rest"],
          "description": "数据源类型。"
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "文件路径（对象存储 key 或本地路径）。"
            },
            "format": {
              "enum": ["csv", "xlsx", "json"],
              "description": "文件格式。"
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secret_id": {
              "type": "string",
              "format": "uuid",
              "description": "存储 PostgreSQL DSN 的密钥引用（绝不内联 DSN 明文）。"
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "只读查询 SQL（仅支持 SELECT，连接器内部强制 LIMIT）。"
            }
          }
        },
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secret_id": {
              "type": "string",
              "format": "uuid",
              "description": "存储 REST base URL 与认证令牌的密钥引用（绝不内联 token 明文）。"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "REST 端点路径（拼接在 base URL 之后）。"
            },
            "method": {
              "enum": ["GET", "POST"],
              "description": "HTTP 方法。"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "target_variable_version_id", "missing_policy"],
        "additionalProperties": false,
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1,
            "description": "源字段路径（如列名或 JSON 路径）。"
          },
          "target_variable_version_id": {
            "type": "string",
            "format": "uuid",
            "description": "目标已发布标准变量版本 ID。"
          },
          "source_unit": {
            "type": ["string", "null"],
            "description": "源数据单位代码（可选，用于单位换算校验）。"
          },
          "missing_policy": {
            "enum": ["reject", "null", "default"],
            "description": "缺失值处理策略：reject=整行拒绝，null=置空，default=使用默认值。"
          },
          "default_value": {
            "type": ["string", "null"],
            "description": "missing_policy=default 时的默认值。"
          }
        }
      }
    }
  }
}
