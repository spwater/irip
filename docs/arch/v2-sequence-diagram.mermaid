%% IRIP V2 Sequence Diagrams — Component Publish / Flow Execute / Model Predict
%% Generated by 高见远 (Gao), Architect

%% ══════════════════════════════════════════════════════════════════
%% Sequence 1: Component Publish Flow
%% ══════════════════════════════════════════════════════════════════

sequenceDiagram
    autonumber
    actor Admin as 平台管理员
    participant API as Components API
    participant Val as ManifestValidator
    participant Reg as ComponentRegistryService
    participant DB as PostgreSQL
    participant S3 as MinIO/S3

    Admin->>API: POST /api/v1/components (YAML manifest)
    API->>Val: validate(yaml_text)
    Val->>Val: load JSON Schema v1
    Val->>Val: jsonschema.validate(manifest_dict, schema)
    Val-->>API: ComponentManifest (frozen)
    API->>Reg: publish(manifest)
    Reg->>DB: SELECT component WHERE name=? AND org_id=?
    alt Component not exists
        Reg->>DB: INSERT component (status=draft)
    end
    Reg->>DB: SELECT component_version WHERE component_id=? AND version=?
    alt Version already published
        Reg-->>API: AppError(code=version_exists)
    else New version
        Reg->>Val: compute sha256(manifest_yaml)
        Reg->>DB: INSERT component_version (immutable, status=published)
        Reg->>DB: UPDATE component SET status=published
    end
    Reg-->>API: ComponentVersion_ORM
    API-->>Admin: 201 Created (component detail + manifest)

%% ══════════════════════════════════════════════════════════════════
%% Sequence 2: Flow Execution Flow (with recovery)
%% ══════════════════════════════════════════════════════════════════

sequenceDiagram
    autonumber
    actor Engineer as 数据工程师
    participant API as Flows API
    participant FRT as FlowRuntimeService
    participant FVal as FlowValidationService
    participant Reg as ComponentRegistryService
    participant Job as JobService
    participant DB as PostgreSQL
    participant Worker as Celery Worker
    participant Runner as ComponentRunner

    Engineer->>API: POST /api/v1/flows (code, nodes, edges)
    API->>FVal: validate_dag(nodes, edges)
    FVal->>FVal: Kahn's algorithm (cycle detection)
    FVal->>FVal: topological_sort()
    FVal->>Reg: get(node.component_name, node.component_version)
    Reg-->>FVal: ComponentManifest (port schemas)
    FVal->>FVal: check_port_types(nodes, edges, manifests)
    FVal->>FVal: check_param_schema(node, manifest)
    FVal-->>API: ValidationResult(valid=True)
    API->>DB: INSERT flow_definition (status=draft)
    API->>DB: INSERT flow_definition_version (immutable, status=published)
    API-->>Engineer: 201 Created (flow version)

    Engineer->>API: POST /api/v1/flows/{id}/runs (inputs)
    API->>FRT: create_run(flow_version_id, inputs)
    FRT->>DB: INSERT flow_run (status=pending)
    FRT->>Job: accept(kind=flow_execute, payload)
    Job->>DB: INSERT job (status=accepted)
    FRT->>DB: UPDATE flow_run SET job_id=?
    API-->>Engineer: 202 Accepted (run_id, job_id)

    Worker->>Job: lease(job_id)
    Job-->>Worker: WorkerLease
    Worker->>FRT: execute(run_id)
    FRT->>DB: SELECT flow_run, flow_definition_version
    FRT->>FRT: topological_sort(nodes, edges)

    loop For each node in topo order
        FRT->>DB: SELECT flow_node_execution WHERE run_id=? AND node_id=?
        alt Node already succeeded (recovery)
            FRT->>FRT: skip node (use cached output)
        else Node not executed or failed
            FRT->>Reg: get(node.component_name, node.component_version)
            Reg-->>FRT: ComponentManifest
            FRT->>FRT: resolve input bindings (from upstream outputs)
            FRT->>DB: INSERT flow_node_execution (status=running)
            FRT->>Runner: run(manifest, context, params)
            Runner->>Runner: apply timeout + cancel check
            Runner-->>FRT: ComponentResult
            FRT->>DB: UPDATE flow_node_execution (status=succeeded, summary)
        end
    end

    FRT->>FRT: compute output_digest (sha256 of all node outputs)
    FRT->>DB: UPDATE flow_run (status=succeeded, output_digest)
    Worker->>Job: complete(job_id, result)
    Worker-->>Worker: ack

%% ══════════════════════════════════════════════════════════════════
%% Sequence 3: Model Predict Flow (with fact write-back)
%% ══════════════════════════════════════════════════════════════════

sequenceDiagram
    autonumber
    actor Researcher as 研究员
    participant Web as PredictionWorkbench
    participant API as Models API
    participant Svc as ModelService
    participant Reg as ComponentRegistryService
    participant Adapter as ModelAdapter (CLI)
    participant AppChk as ApplicabilityChecker
    participant FactSvc as FactService
    participant DB as PostgreSQL
    participant S3 as MinIO/S3

    Researcher->>Web: Select model (grate_cooler v2)
    Web->>API: GET /api/v1/models/{id}
    API->>DB: SELECT model, model_version
    API-->>Web: ModelDetail (contract.input_schema)

    Researcher->>Web: Input parameters (grate_speed=1.5, ...)
    Web->>API: POST /api/v1/models/{version_id}/predict (inputs)
    API->>Svc: predict(model_version_id, inputs)

    Svc->>DB: SELECT model_version (contract, adapter_config, artifact_id)
    Svc->>S3: presign_download(artifact_id)
    Svc->>Adapter: load(model_path, contract)
    Adapter-->>Svc: loaded

    Svc->>Adapter: validate_input(inputs)
    Adapter-->>Svc: ValidationResult(valid=True)

    Svc->>AppChk: check(inputs, applicability_domain)
    AppChk->>AppChk: per-dimension min/max boundary check
    AppChk-->>Svc: ApplicabilityResult(in_domain=True/False)

    Svc->>Adapter: predict(inputs)
    Adapter-->>Svc: outputs dict (secondary_air_temp, ...)

    Svc->>FactSvc: create_fact(
        fact_type=model_execution,
        subject_id=model_id,
        value=outputs,
        conditions=inputs_snapshot,
        derivation_ref=model_version_id
    )
    FactSvc->>DB: INSERT fact + fact_revision (immutable)
    FactSvc-->>Svc: FactRef (fact_id, revision_id)

    Svc->>DB: INSERT prediction_record (inputs, outputs, applicability, fact_id)
    Svc-->>API: PredictionResult (outputs + applicability + fact_ref)
    API-->>Web: 200 OK (prediction + confidence + domain)
    Web-->>Researcher: Display results + provenance link

%% ══════════════════════════════════════════════════════════════════
%% Sequence 4: Model Train → Evaluate → Publish Lifecycle
%% ══════════════════════════════════════════════════════════════════

sequenceDiagram
    autonumber
    actor MEng as 模型工程师
    participant API as Models API
    participant Svc as ModelService
    participant Job as JobService
    participant Worker as Celery Worker
    participant DB as PostgreSQL
    participant S3 as MinIO/S3

    MEng->>API: POST /api/v1/models (code, display_name)
    API->>DB: INSERT model (status=draft)
    API-->>MEng: ModelRef

    MEng->>API: POST /api/v1/models/{id}/train (dataset_artifact_id, params)
    API->>Svc: train(model_id, dataset_artifact_id, params)
    Svc->>S3: presign_download(dataset_artifact_id)
    Svc->>Job: accept(kind=model_train, payload)
    Job->>DB: INSERT job
    API-->>MEng: 202 Accepted (job_id)

    Worker->>Svc: train_async(job_id, payload)
    Svc->>S3: download dataset
    Svc->>SVC: sklearn.RandomForestRegressor.fit(X, y)
    Svc->>S3: upload model file (content-addressed)
    Svc->>DB: INSERT model_version (status=draft, artifact_id, metrics)
    Svc->>DB: UPDATE model SET status=pending_validation
    Worker->>Job: complete(job_id)

    MEng->>API: POST /api/v1/models/{version_id}/evaluate (test_artifact_id)
    API->>Svc: evaluate(model_version_id, test_artifact_id)
    Svc->>S3: download test set
    Svc->>SVC: model.predict(X_test) → compute R², RMSE, MAE
    Svc->>DB: UPDATE model_version SET metrics_json={...}
    API-->>MEng: EvaluationReport (R², RMSE, MAE per output)

    MEng->>API: POST /api/v1/models/{version_id}/publish
    API->>Svc: publish(model_version_id)
    Svc->>DB: UPDATE model_version SET status=published
    Svc->>DB: UPDATE model SET current_version_id=?, status=published
    Svc->>DB: INSERT audit_event (action=model_publish)
    API-->>MEng: ModelDetail (published, current_version=v1)

    MEng->>API: POST /api/v1/models/{id}/rollback (target_version_id)
    Svc->>DB: UPDATE model SET current_version_id=target
    Svc->>DB: INSERT audit_event (action=model_rollback, before=v2, after=v1)
    API-->>MEng: ModelDetail (rolled back to v1)
