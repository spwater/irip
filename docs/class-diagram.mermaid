classDiagram
    direction TB

    class Fact {
        +UUID id
        +UUID organization_id
        +UUID~None~ template_version_id
        +str fact_type
        +UUID object_id
        +str status
        +int lock_version
        +str~None~ idempotency_key
        +datetime created_at
        +datetime updated_at
        +UUID~None~ created_by
        +str subject_id
        +UUID~None~ method_version_id
        +UUID~None~ flow_run_id
        +datetime~None~ started_at
        +datetime~None~ ended_at
        +str~None~ task_code
        +str~None~ task_name
        +str~None~ department_name
        +str~None~ operator
        +str~None~ run_operator
        +str~None~ equipment_name
        +tsvector search_vector
    }

    class FactDataIndex {
        +UUID id
        +UUID fact_id
        +int row_index
        +str key
        +str~None~ value_text
        +float~None~ value_number
    }

    class FactRef {
        +UUID fact_id
        +str fact_type
        +str subject_id
        +str status
    }

    class CreateFactCommand {
        +str fact_type
        +UUID~None~ template_version_id
        +UUID organization_id
        +UUID object_id
        +str subject_id
        +datetime~None~ started_at
        +datetime~None~ ended_at
        +UUID~None~ method_version_id
        +str~None~ idempotency_key
        +UUID created_by
        +str~None~ task_code
        +str~None~ task_name
        +str~None~ department_name
        +str~None~ operator
        +str~None~ run_operator
        +str~None~ equipment_name
        +UUID~None~ flow_run_id
    }

    class FactService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        -_actor_id: UUID~None~
        +organization_id: UUID
        +session_factory: async_sessionmaker
        +create(command: CreateFactCommand) FactRef
        +get(fact_id: UUID) FactRef
        +search(query: str, filters: dict, cursor: str, page_size: int) tuple
        +list_facts(filters: dict, cursor: str, page_size: int) tuple
    }

    class FactRepository {
        +insert_fact(session, ...) Fact
        +get_fact(session, fact_id, org_id) Fact
        +search_facts(session, query, org_id, filters, cursor, page_size) tuple
        +list_facts(session, org_id, filters, cursor, page_size) tuple
        +find_by_idempotency_key(session, org_id, key) Fact~None~
    }

    class EvidenceMember {
        +UUID fact_id
        +str decision
        +str reason
        +to_dict() dict
        +from_dict(d: dict) EvidenceMember
    }

    class EvidenceService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        -_actor_id: UUID~None~
        +create_set(name: str) dict
        +freeze(set_id: UUID, fact_filter: dict) EvidenceSetRef
        +get_set(set_id: UUID) dict
        +list_members(set_id: UUID, version: int) tuple
    }

    class ProvenanceGraphService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        +get_graph(derivation_run_id: UUID) ProvenanceGraph
        +get_paths_to_raw(parameter_version_id: UUID) list
        +add_edge(...) None
    }

    class DerivationService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        -_actor_id: UUID~None~
        +create_run(evidence_set_version_id, recipe_version_id) DerivationRunRef
        +replay(run_id: UUID) DerivationRunRef
        +get_run(run_id: UUID) DerivationRunRef
        +list_runs(cursor: str, page_size: int) tuple
    }

    class ParameterService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        -_actor_id: UUID~None~
        +create_parameter(variable_code, object_id) dict
        +create_candidate(...) dict
        +approve(candidate_id, reviewer) ParameterVersionRef
        +reject(candidate_id, reviewer, comment) dict
        +get_parameter(parameter_id) dict
        +get_version(parameter_id, version) ParameterVersionRef
        +list_parameters(filters, cursor, page_size) tuple
        +list_candidates(parameter_id) list
        +deprecate(parameter_id) dict
    }

    class IngestionPipeline {
        -_factory: async_sessionmaker
        -_fact_service: FactService
        -_quality_engine: QualityEngine
        -_org_id: UUID
        -_actor_id: UUID~None~
        +ingest_file(file_path, mapping_profile_version_id, template_version_id, object_id, method_version_id) IngestionResult
        +ingest_batch(file_paths, ...) tuple
    }

    class ModelService {
        -_factory: async_sessionmaker
        -_org_id: UUID
        -_artifact_service: Any
        -_fact_service: Any~None~
        -_clock: Clock
        +create_model(code, display_name) Model
        +create_version(model_id, contract, ...) ModelVersion
        +publish(model_id, version_id) Model
        +predict(model_id, inputs) PredictionResult
        +predict_version(model_version_id, inputs) PredictionResult
    }

    Fact ||--o{ FactDataIndex : "1:N (fact_id FK)"
    FactService --> FactRepository : uses
    FactRepository --> Fact : CRUD
    FactService ..> FactRef : returns
    FactService ..> CreateFactCommand : accepts
    EvidenceService ..> EvidenceMember : creates
    EvidenceService --> Fact : queries
    ProvenanceGraphService --> Fact : queries
    DerivationService ..> EvidenceMember : reads
    DerivationService --> Fact : queries
    ParameterService --> Fact : queries (via staleness removed)
    IngestionPipeline --> FactService : uses
    IngestionPipeline ..> CreateFactCommand : builds
    ModelService --> FactService : uses
    ModelService ..> CreateFactCommand : builds
