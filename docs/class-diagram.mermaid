%% facts.py 下沉方案 —— 类图
%% 架构师：高见远

classDiagram
  direction LR

  %% ---- 值对象 ----
  class FactRef {
    +fact_id: UUID
    +fact_type: str
    +subject_id: str
    +status: str
  }
  class FactDetailRow {
    +fact_id: UUID
    +fact_type: str
    +subject_id: str
    +status: str
    +task_code: str | None
    +task_name: str | None
    +project_name: str | None
    +department_name: str | None
    +operator: str | None
    +run_operator: str | None
    +equipment_name: str | None
    +data_summary: str | None
    +created_at: datetime | None
  }
  class FactMeta {
    +fact_id: UUID
    +source_artifact_id: UUID | None
    +department_id: UUID | None
    +owner_user_id: UUID | None
    +flow_run_id: UUID | None
  }
  class FactSnapshotRow {
    +fact_id: UUID
    +fact_type: str | None
    +subject_id: str | None
    +status: str | None
    +task_code: str | None
    +task_name: str | None
    +project_name: str | None
    +department_name: str | None
    +operator: str | None
    +run_operator: str | None
    +equipment_name: str | None
    +created_at: datetime | None
  }

  %% ---- ORM 实体（既有，仅示意关系） ----
  class Fact {
    +id: UUID
    +fact_type: str
    +status: str
    +subject_id: str
    +task_code: str | None
    +task_name: str | None
    +department_name: str | None
    +operator: str | None
    +run_operator: str | None
    +equipment_name: str | None
    +flow_run_id: UUID | None
    +source_artifact_id: UUID | None
    +department_id: UUID
    +owner_user_id: UUID
    +created_at: datetime
  }
  class FactDataIndex {
    +fact_id: UUID
    +key: str
    +value_text: str | None
    +value_number: float | None
  }
  Fact "1" o-- "many" FactDataIndex : CASCADE

  %% ---- Repository ----
  class FactRepository {
    <<静态方法 / async>>
    +insert_fact(session, ...) Fact
    +get_fact(session, fact_id, org_id) Fact
    +search_facts(session, query, org_id, filters, cursor, page_size) tuple~list~dict~, str~
    +list_facts(session, org_id, filters, cursor, page_size) tuple~list~dict~, str~
    +find_by_idempotency_key(session, org_id, key) Fact | None
    +fetch_snapshots(session, fact_ids, include_project, include_base, with_task_code_fallback) dict~UUID, FactSnapshotRow~
    +count_group_by_task(session, fact_ids) dict~str, int~
    +search_data_index(session, q, key, value, min_value, max_value, page_size) list~UUID~
    +find_fact_in_dept(session, fact_id, dept_id) Fact | None
    +update_fact_status(session, fact_id, status) None
    +get_fact_meta(session, fact_id) FactMeta | None
    +get_facts_meta_by_task(session, task_code) list~FactMeta~
    +find_json_artifact(session, fact_id) Artifact | None
    +find_source_file_artifact(session, fact_id) Artifact | None
    +delete_facts(session, fact_ids) None
    +delete_flow_runs(session, flow_run_ids) None
  }

  %% ---- FactService（写 + 基础 ref） ----
  class FactService {
    -_factory: async_sessionmaker
    -_dept_id: UUID
    -_actor_id: UUID | None
    +__init__(session_factory, department_id, actor_id)
    +department_id UUID
    +session_factory async_sessionmaker
    +create(command: CreateFactCommand) FactRef
    +get(fact_id: UUID) FactRef
    +search(query, filters, cursor, page_size) tuple~list~FactRef~, str~
    +list_facts(filters, cursor, page_size) tuple~list~FactRef~, str~
    +archive(fact_id: UUID) None
    +get_fact_meta(fact_id: UUID) FactMeta
    +delete_fact_record(fact_id, flow_run_id) None
    +get_facts_meta_by_task(task_code: str) list~FactMeta~
    +delete_facts_records(fact_ids, flow_run_ids) None
  }

  %% ---- FactQueryService（复杂读，新建） ----
  class FactQueryService {
    -_factory: async_sessionmaker
    -_dept_id: UUID
    -_actor_id: UUID | None
    -_s3_repo: S3Repository
    +__init__(session_factory, department_id, actor_id, s3_repo)
    +department_id UUID
    +session_factory async_sessionmaker
    -_artifact_service() ArtifactService
    +list_facts_detail(filters, cursor, page_size) tuple~list~FactDetailRow~, str~, dict~str,int~~
    +search_facts_detail(query, filters, cursor, page_size) tuple~list~FactDetailRow~, str~, dict~str,int~~
    +search_by_data(q, key, value, min_value, max_value, page_size) tuple~list~FactDetailRow~, dict~str,int~~
    +get_fact_detail(fact_id: UUID) FactDetailRow
    +get_fact_data(fact_id: UUID) dict
    -_build_data_summary(fact_id, session, artifact_service) str | None
    -_resolve_task_info(fact_record, session) dict
  }

  %% ---- 外部依赖 ----
  class ArtifactService {
    +get_bytes(artifact_id) bytes
    +delete_artifact(artifact_id) None
  }
  class ScopedSessionMixin {
    <<mixin>>
    -_scoped_session() AsyncSession
  }

  %% ---- Router ----
  class FactsRouter {
    +create_fact(body, user, service)
    +list_facts(user, query_service, ...)
    +search_facts(user, query_service, ...)
    +search_facts_by_data(user, query_service, ...)
    +get_fact(fact_id, user, query_service)
    +get_fact_data(fact_id, user, query_service)
    +archive_fact(fact_id, user, service)
    +delete_fact(fact_id, user, service)
    +delete_facts_by_task(task_code, user, service)
  }

  %% ---- 关系 ----
  ScopedSessionMixin <|-- FactService
  ScopedSessionMixin <|-- FactQueryService
  ScopedSessionMixin <|-- ArtifactService

  FactService ..> FactRepository : 委托 DB
  FactService ..> FactRef : 返回
  FactService ..> FactMeta : 返回
  FactQueryService ..> FactRepository : 委托 DB
  FactQueryService ..> FactDetailRow : 返回
  FactQueryService ..> ArtifactService : 下载/读取
  FactRepository ..> Fact : 查询
  FactRepository ..> FactDataIndex : 查询
  FactRepository ..> FactSnapshotRow : 返回
  FactRepository ..> FactMeta : 返回

  FactsRouter ..> FactService : 写 + 基础
  FactsRouter ..> FactQueryService : 复杂读
  FactsRouter ..> FactResponse : 映射
  FactsRouter ..> ArtifactService : 删 MinIO（delete）
  FactsRouter ..> check_management_permission : 归属校验
