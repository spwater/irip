%% IRIP V2 Class Diagram — Component System + Flow Engine + Model Lifecycle
%% Generated by 高见远 (Gao), Architect

classDiagram
    direction TB

    %% ── Component SDK Core ──────────────────────────────────────────

    class ComponentManifest {
        <<frozen dataclass>>
        +name: str
        +version: str
        +kind: str
        +runtime: str
        +inputs: tuple~PortSpec, ...~
        +outputs: tuple~PortSpec, ...~
        +parameters: dict
        +dependencies: tuple~str, ...~
        +raw_yaml: str
        +sha256: str
    }

    class PortSpec {
        <<frozen dataclass>>
        +name: str
        +data_type: str
        +required: bool
        +schema: dict
    }

    class ComponentContext {
        <<frozen dataclass>>
        +organization_id: UUID
        +user_id: UUID
        +clock: Clock
        +artifact_service: ArtifactService
        +job_id: UUID
        +cancel_event: asyncio.Event
        +secrets: dict~str, str~
        +workdir: Path
    }

    class ComponentResult {
        <<frozen dataclass>>
        +outputs: dict~str, object~
        +summary: str
        +metadata: dict
        +diagnostics: dict
    }

    class Component {
        <<Protocol>>
        +execute(context: ComponentContext, params: dict) ComponentResult*
    }

    class ComponentRunner {
        <<Protocol>>
        +run(manifest: ComponentManifest, context: ComponentContext, params: dict) ComponentResult*
    }

    class PythonComponentRunner {
        -registry: dict~tuple~str,str~, Component~
        +register(manifest: ComponentManifest, impl: Component) void
        +run(manifest: ComponentManifest, context: ComponentContext, params: dict) ComponentResult
        -_apply_timeout(coro: Coroutine, timeout: float) ComponentResult
        -_check_cancel(event: asyncio.Event) void
    }

    class CLIComponentRunner {
        -timeout: float
        -network_allowlist: tuple~str, ...~
        +run(manifest: ComponentManifest, context: ComponentContext, params: dict) ComponentResult
        -_spawn_subprocess(manifest: ComponentManifest, params_json: bytes) subprocess.Popen
        -_communicate(proc: subprocess.Popen, stdin: bytes) bytes
        -_parse_result(stdout: bytes) ComponentResult
    }

    class ManifestValidator {
        -schema: dict
        +validate(yaml_text: str) ComponentManifest
        -_load_schema() dict
    }

    %% ── Component Registry (ORM + Service) ──────────────────────────

    class Component_ORM {
        <<ORM: component>>
        +id: UUID
        +organization_id: UUID
        +name: str
        +kind: str
        +status: str
        +lock_version: int
        +created_at: datetime
        +updated_at: datetime
    }

    class ComponentVersion_ORM {
        <<ORM: component_version>>
        +id: UUID
        +component_id: UUID
        +version: str
        +manifest_yaml: str
        +manifest_sha256: str
        +runtime: str
        +port_schemas: dict
        +status: str
        +published_at: datetime
        +created_at: datetime
    }

    class ComponentRegistryService {
        -session_factory: async_sessionmaker
        -organization_id: UUID
        +publish(manifest: ComponentManifest) ComponentVersion_ORM
        +get(name: str, version: str) ComponentVersion_ORM
        +list(kind: str, status: str) list~ComponentVersion_ORM~
        +deprecate(name: str, version: str) Component_ORM
    }

    %% ── Flow Engine ─────────────────────────────────────────────────

    class FlowNode {
        <<frozen dataclass>>
        +node_id: str
        +component_name: str
        +component_version: str
        +params: dict
        +input_bindings: dict~str, str~
    }

    class FlowEdge {
        <<frozen dataclass>>
        +source_node: str
        +source_port: str
        +target_node: str
        +target_port: str
    }

    class FlowDefinitionVersion {
        <<frozen dataclass>>
        +version: int
        +nodes: tuple~FlowNode, ...~
        +edges: tuple~FlowEdge, ...~
        +random_seed: int
        +sha256: str
    }

    class FlowDefinition_ORM {
        <<ORM: flow_definition>>
        +id: UUID
        +organization_id: UUID
        +code: str
        +display_name: str
        +status: str
        +lock_version: int
        +created_at: datetime
        +updated_at: datetime
    }

    class FlowDefinitionVersion_ORM {
        <<ORM: flow_definition_version>>
        +id: UUID
        +flow_definition_id: UUID
        +version: int
        +nodes_json: list
        +edges_json: list
        +random_seed: int
        +digest: str
        +status: str
        +published_at: datetime
    }

    class FlowRun_ORM {
        <<ORM: flow_run>>
        +id: UUID
        +organization_id: UUID
        +flow_version_id: UUID
        +status: str
        +job_id: UUID
        +input_snapshot: dict
        +output_digest: str
        +started_at: datetime
        +completed_at: datetime
        +created_at: datetime
    }

    class FlowNodeExecution_ORM {
        <<ORM: flow_node_execution>>
        +id: UUID
        +flow_run_id: UUID
        +node_id: str
        +status: str
        +input_summary: dict
        +output_summary: dict
        +diagnostics: dict
        +started_at: datetime
        +completed_at: datetime
        +duration_ms: int
    }

    class FlowValidationService {
        +validate_dag(nodes: list~FlowNode~, edges: list~FlowEdge~) ValidationResult
        +check_port_types(nodes, edges, registry) ValidationResult
        +check_param_schema(node: FlowNode, manifest: ComponentManifest) ValidationResult
        -_detect_cycle(nodes, edges) bool
        -_topological_sort(nodes, edges) list~str~
    }

    class FlowRuntimeService {
        -session_factory: async_sessionmaker
        -registry: ComponentRegistryService
        -runner: ComponentRunner
        +create_run(flow_version_id: UUID, inputs: dict) FlowRun_ORM
        +execute(run_id: UUID) void
        +resume(run_id: UUID) void
        +cancel(run_id: UUID) void
        +retry_node(run_id: UUID, node_id: str) void
        -_schedule_nodes(run: FlowRun_ORM, topo_order: list~str~) void
        -_execute_node(run: FlowRun_ORM, node: FlowNode, inputs: dict) ComponentResult
    }

    class ValidationResult {
        <<frozen dataclass>>
        +valid: bool
        +errors: tuple~str, ...~
        +warnings: tuple~str, ...~
    }

    %% ── Model Lifecycle ─────────────────────────────────────────────

    class ModelContract {
        <<frozen dataclass>>
        +name: str
        +version: str
        +input_schema: dict
        +output_schema: dict
        +applicability_domain: dict
        +sha256: str
    }

    class ModelAdapter {
        <<Protocol>>
        +load(model_path: str, contract: ModelContract) void*
        +validate_input(inputs: dict) ValidationResult*
        +predict(inputs: dict) dict*
        +healthcheck() bool*
    }

    class CLIModelAdapter {
        -command: list~str~
        -model_path: str
        +load(model_path: str, contract: ModelContract) void
        +validate_input(inputs: dict) ValidationResult
        +predict(inputs: dict) dict
        +healthcheck() bool
    }

    class Model_ORM {
        <<ORM: model>>
        +id: UUID
        +organization_id: UUID
        +code: str
        +display_name: str
        +status: str
        +current_version_id: UUID
        +lock_version: int
        +created_at: datetime
        +updated_at: datetime
    }

    class ModelVersion_ORM {
        <<ORM: model_version>>
        +id: UUID
        +model_id: UUID
        +version: int
        +contract_json: dict
        +artifact_id: UUID
        +adapter_type: str
        +adapter_config: dict
        +metrics_json: dict
        +applicability_json: dict
        +status: str
        +created_by: UUID
        +created_at: datetime
        +published_at: datetime
    }

    class ModelService {
        -session_factory: async_sessionmaker
        -organization_id: UUID
        +train(model_id: UUID, dataset_artifact_id: UUID, params: dict) ModelVersion_ORM
        +evaluate(model_version_id: UUID, test_artifact_id: UUID) dict
        +publish(model_version_id: UUID) Model_ORM
        +predict(model_version_id: UUID, inputs: dict) dict
        +rollback(model_id: UUID, target_version_id: UUID) Model_ORM
        +deprecate(model_id: UUID) Model_ORM
    }

    class ApplicabilityChecker {
        +check(inputs: dict, domain: dict) ApplicabilityResult
    }

    class ApplicabilityResult {
        <<frozen dataclass>>
        +in_domain: bool
        +violations: tuple~str, ...~
        +per_dimension: dict
    }

    %% ── Relationships ──────────────────────────────────────────────

    ComponentManifest --> PortSpec : contains
    ComponentManifest ..> ManifestValidator : validated by
    ComponentContext --> ComponentResult : produces via Component
    Component ..> ComponentContext : receives
    Component ..> ComponentResult : returns

    ComponentRunner <|.. PythonComponentRunner : implements
    ComponentRunner <|.. CLIComponentRunner : implements
    PythonComponentRunner --> Component : invokes
    CLIComponentRunner ..> ComponentManifest : reads runtime config

    ComponentRegistryService --> Component_ORM : manages
    ComponentRegistryService --> ComponentVersion_ORM : manages
    ComponentVersion_ORM --> Component_ORM : belongs to
    ComponentRegistryService ..> ComponentManifest : publishes

    FlowDefinitionVersion --> FlowNode : contains
    FlowDefinitionVersion --> FlowEdge : contains
    FlowDefinition_ORM --> FlowDefinitionVersion_ORM : versions
    FlowValidationService ..> FlowDefinitionVersion : validates
    FlowValidationService ..> ComponentRegistryService : queries manifests
    FlowRuntimeService --> FlowRun_ORM : manages
    FlowRuntimeService --> FlowNodeExecution_ORM : records
    FlowRun_ORM --> FlowDefinitionVersion_ORM : executes
    FlowRun_ORM --> FlowNodeExecution_ORM : contains
    FlowRuntimeService ..> ComponentRunner : delegates node execution
    FlowRuntimeService ..> ComponentRegistryService : resolves components

    ModelContract ..> ModelAdapter : defines interface
    ModelAdapter <|.. CLIModelAdapter : implements
    Model_ORM --> ModelVersion_ORM : versions
    ModelService --> Model_ORM : manages
    ModelService --> ModelVersion_ORM : manages
    ModelService ..> ModelAdapter : invokes
    ModelService ..> ApplicabilityChecker : checks domain
    ApplicabilityChecker --> ApplicabilityResult : produces
